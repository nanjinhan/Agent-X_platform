# 로컬 개발용 예시. 실제 값은 .env에 두고 커밋하지 않는다.

# Database
DATABASE_URL=postgresql://signals:signals_local_dev@localhost:5433/signals

# Redis
REDIS_URL=redis://localhost:6379

# Core API / services
PORT_CORE_API=3000
PORT_SIGNAL_SERVICE=3001
PORT_NOTIFICATION_SERVICE=3002

# JWT (SYS-025) — 운영에서는 KMS/시크릿 매니저 사용
JWT_ACCESS_SECRET=change-me-local-only-access
JWT_REFRESH_SECRET=change-me-local-only-refresh
JWT_TICKET_SECRET=change-me-local-only-ticket
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30

# 개인정보 컬럼 암호화 키 (SEC-009, AES-256-GCM) — 32바이트 hex. 운영은 KMS
NAME_ENC_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# 쿠키 (Refresh Token은 HttpOnly Secure Cookie, SYS-025)
COOKIE_SECURE=false

# 서명 키 (SEC-017) — 운영에서는 HSM/KMS. 로컬은 개발용 키 경로
SIGNING_KEY_ID=signals-dev-01

# 시장데이터 (T2~T3에서 사용)
KRX_API_BASE=
POLYGON_API_KEY=
ECOS_API_KEY=
DART_API_KEY=
